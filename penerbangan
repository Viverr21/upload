-- ============================================
-- DATABASE PENERBANGAN - Becky
-- 100% SESUAI SOAL PENUGASAN
-- Semua Primary Key = VARCHAR(255)
-- Tanpa FOREIGN KEY
-- ============================================

-- Membuat database
CREATE DATABASE IF NOT EXISTS db_penerbangan_becky;
USE db_penerbangan_becky;

-- ============================================
-- 1. MEMBUAT TABEL
-- ============================================

-- a. Akun
CREATE TABLE Akun (
    id_akun VARCHAR(255) PRIMARY KEY,
    username VARCHAR(255),
    password VARCHAR(255),
    nama_lengkap VARCHAR(255),
    email VARCHAR(255),
    nomor_telepon VARCHAR(255)
);

-- b. Maskapai
CREATE TABLE Maskapai (
    id_maskapai VARCHAR(255) PRIMARY KEY,
    kode_maskapai VARCHAR(255),
    nama_maskapai VARCHAR(255),
    negara_asal VARCHAR(255),
    deskripsi TEXT
);

-- c. Negara
CREATE TABLE Negara (
    id_negara VARCHAR(255) PRIMARY KEY,
    kode_negara VARCHAR(255),
    nama_negara VARCHAR(255),
    ibukota VARCHAR(255)
);

-- d. Bandara
CREATE TABLE Bandara (
    id_bandara VARCHAR(255) PRIMARY KEY,
    kode_bandara VARCHAR(255),
    nama_bandara VARCHAR(255),
    kota VARCHAR(255),
    id_negara VARCHAR(255),
    jumlah_terminal INT
);

-- e. Jadwal Penerbangan
CREATE TABLE Jadwal_Penerbangan (
    id_jadwal VARCHAR(255) PRIMARY KEY,
    kode_penerbangan VARCHAR(255),
    id_maskapai VARCHAR(255),
    id_bandara_keberangkatan VARCHAR(255),
    id_bandara_tujuan VARCHAR(255),
    waktu_keberangkatan DATETIME,
    waktu_kedatangan DATETIME,
    harga_per_tiket DECIMAL(12,2)
);

-- f. Transaksi
CREATE TABLE Transaksi (
    id_transaksi VARCHAR(255) PRIMARY KEY,
    id_akun VARCHAR(255),
    tanggal_transaksi DATE,
    id_jadwal VARCHAR(255),
    id_kode_promo VARCHAR(255),
    total_harga DECIMAL(12,2)
);

-- g. Detail Transaksi
CREATE TABLE Detail_Transaksi (
    id_detail VARCHAR(255) PRIMARY KEY,
    id_transaksi VARCHAR(255),
    nama_lengkap_penumpang VARCHAR(255),
    nomor_kursi VARCHAR(255),
    status_pembayaran VARCHAR(255)
);

-- h. Kode Promo
CREATE TABLE Kode_Promo (
    id_promo VARCHAR(255) PRIMARY KEY,
    kode_promo VARCHAR(255),
    persentase_diskon DECIMAL(5,2),
    berlaku_sampai DATE,
    deskripsi TEXT
);

-- i. Status Penerbangan
CREATE TABLE Status_Penerbangan (
    id_status VARCHAR(255) PRIMARY KEY,
    nama_status VARCHAR(255)
);

-- j. Perubahan Status Jadwal Penerbangan
CREATE TABLE Perubahan_Status_Jadwal (
    id_perubahan VARCHAR(255) PRIMARY KEY,
    id_jadwal VARCHAR(255),
    id_status VARCHAR(255),
    waktu_perubahan DATETIME,
    keterangan TEXT
);

