-- =====================================================
-- MEMBUAT TABEL (TANPA FOREIGN KEY)
-- =====================================================

-- 1. TABEL AKUN
CREATE TABLE Akun (
    Id_Akun VARCHAR(10) PRIMARY KEY,
    Username VARCHAR(50),
    Password VARCHAR(50),
    Nama VARCHAR(100),
    Tanggal_Lahir DATE,
    Nomor_Telepon VARCHAR(15)
);

-- 2. TABEL MASKAPAI
CREATE TABLE Maskapai (
    Id_Maskapai VARCHAR(10) PRIMARY KEY,
    Nama_Maskapai VARCHAR(100),
    Perusahaan VARCHAR(100),
    Jumlah_Kru INT,
    Deskripsi TEXT
);

-- 3. TABEL NEGARA
CREATE TABLE Negara (
    Id_Negara VARCHAR(10) PRIMARY KEY,
    Nama_Negara VARCHAR(50),
    Ibu_Kota_Negara VARCHAR(50)
);

-- 4. TABEL BANDARA
CREATE TABLE Bandara (
    Id_Bandara VARCHAR(10) PRIMARY KEY,
    Nama_Bandara VARCHAR(100),
    Kode_IATA VARCHAR(5),
    Kota VARCHAR(50),
    Id_Negara VARCHAR(10),
    Jumlah_Terminal INT,
    Alamat TEXT
);

-- 5. TABEL JADWAL PENERBANGAN
CREATE TABLE Jadwal_Penerbangan (
    Id_Jadwal_Penerbangan VARCHAR(10) PRIMARY KEY,
    Kode_Penerbangan VARCHAR(10),
    Id_Bandara_Keberangkatan VARCHAR(10),
    Id_Tujuan_Bandara VARCHAR(10),
    Id_Maskapai VARCHAR(10),
    Tanggal_Waktu_Keberangkatan DATETIME,
    Durasi_Penerbangan TIME,
    Harga_Pertiket INT
);

-- 6. TABEL TRANSASKSI
CREATE TABLE Transaksi (
    Id_Transaksi VARCHAR(10) PRIMARY KEY,
    Id_Akun VARCHAR(10),
    Tanggal_Transaksi DATE,
    Id_Jadwal_Penerbangan VARCHAR(10),
    Jumlah_Penerbangan INT,
    Total_Harga INT,
    Id_Kode_Promo VARCHAR(10)
);

-- 7. TABEL DETAIL TRANSAKSI
CREATE TABLE Detail_Transaksi (
    Id_Detail_Transaksi VARCHAR(10) PRIMARY KEY,
    Id_Transaksi VARCHAR(10),
    Tiket_Penumpang INT,
    Nama_Lengkap_Penumpang VARCHAR(100)
);

-- 8. TABEL KODE PROMO
CREATE TABLE Kode_Promo (
    Id_Kode_Promo VARCHAR(10) PRIMARY KEY,
    Kode_Promo VARCHAR(20),
    Persentase_Diskon VARCHAR(5),
    Berlaku_Sampai DATE,
    Deskripsi TEXT
);

-- 9. TABEL STATUS PENERBANGAN
CREATE TABLE Status_Penerbangan (
    Id_Status_Penerbangan VARCHAR(10) PRIMARY KEY,
    Nama_Status VARCHAR(20)
);

-- 10. TABEL PERUBAHAN STATUS JADWAL PENERBANGAN
CREATE TABLE Perubahan_Status_Jadwal_Penerbangan (
    Id_Perubahan_Status_Jadwal VARCHAR(10) PRIMARY KEY,
    Id_Jadwal_Penerbangan VARCHAR(10),
    Id_Status_Penerbangan VARCHAR(10),
    Waktu_Perubahan DATETIME,
    Perkiraan_Waktu_Delay TIME
);

