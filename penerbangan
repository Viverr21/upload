-- ============================================
-- 7. INNER JOIN (sesuai format soal)
-- Menampilkan: Id Transaksi | Username | Nama Lengkap Penumpang | 
-- Kode Penerbangan | Maskapai | Id Bandara Keberangkatan | 
-- Id Tujuan Bandara | Status | Total Harga
-- ============================================

SELECT 
    t.id_transaksi AS 'Id Transaksi',
    a.username AS 'Username',
    dt.nama_lengkap_penumpang AS 'Nama Lengkap Penumpang',
    jp.kode_penerbangan AS 'Kode Penerbangan',
    m.nama_maskapai AS 'Maskapai',
    b1.kode_bandara AS 'Id Bandara Keberangkatan',
    b2.kode_bandara AS 'Id Tujuan Bandara',
    s.nama_status AS 'Status',
    t.total_harga AS 'Total Harga'
FROM Transaksi t
JOIN Akun a ON t.id_akun = a.id_akun
JOIN Detail_Transaksi dt ON t.id_transaksi = dt.id_transaksi
JOIN Jadwal_Penerbangan jp ON t.id_jadwal = jp.id_jadwal
JOIN Maskapai m ON jp.id_maskapai = m.id_maskapai
JOIN Bandara b1 ON jp.id_bandara_keberangkatan = b1.id_bandara
JOIN Bandara b2 ON jp.id_bandara_tujuan = b2.id_bandara
LEFT JOIN Perubahan_Status_Jadwal psj ON jp.id_jadwal = psj.id_jadwal
LEFT JOIN Status_Penerbangan s ON psj.id_status = s.id_status
GROUP BY t.id_transaksi
ORDER BY t.id_transaksi;

