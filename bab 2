SELECT 
    nama_mapel, 
    nama_guru, 
    ROUND(AVG(nilai), 2) AS rata_rata 
FROM mata_pelajaran, guru, nilai 
WHERE mata_pelajaran.kode_mapel = nilai.kode_mapel 
AND mata_pelajaran.nitp = guru.nitp 
GROUP BY mata_pelajaran.kode_mapel, nama_mapel, nama_guru
ORDER BY mata_pelajaran.kode_mapel ASC;

SELECT 
    siswa.nis, 
    nama_siswa, 
    nama_mapel, 
    nilai 
FROM siswa, nilai, mata_pelajaran 
WHERE siswa.nis = nilai.nis 
AND nilai.kode_mapel = mata_pelajaran.kode_mapel 
AND nilai < 80 
ORDER BY siswa.nis ASC, nama_siswa ASC;

SELECT 
    nama_siswa, 
    kelas, 
    nilai, 
    CASE 
        WHEN nilai > 80 THEN 'Baik' 
        WHEN nilai >= 75 THEN 'Cukup' 
        ELSE 'Kurang' 
    END AS Predikat 
FROM siswa, nilai, mata_pelajaran 
WHERE siswa.nis = nilai.nis 
AND nilai.kode_mapel = mata_pelajaran.kode_mapel 
AND nama_mapel = 'Basis Data' 
ORDER BY siswa.nis ASC, nama_siswa ASC;

SELECT 
    nama_siswa, 
    kelas, 
    nilai, 
    CASE 
        WHEN nilai > 85 THEN 'Istimewa' 
        WHEN nilai > 80 THEN 'Baik' 
        WHEN nilai >= 75 THEN 'Cukup' 
        ELSE 'Kurang' 
    END AS Predikat 
FROM siswa, nilai, mata_pelajaran 
WHERE siswa.nis = nilai.nis 
AND nilai.kode_mapel = mata_pelajaran.kode_mapel 
AND nama_mapel = 'Pemodelan Perangkat Lunak' 
AND kelas = 'XI RPL B' 
ORDER BY siswa.nis ASC, nama_siswa ASC;

CREATE OR REPLACE VIEW v_ratarata_siswa AS 
SELECT 
    siswa.nis, 
    nama_siswa, 
    kelas, 
    ROUND(AVG(nilai), 1) AS rata_rata 
FROM siswa, nilai 
WHERE siswa.nis = nilai.nis 
GROUP BY siswa.nis, nama_siswa, kelas 
ORDER BY siswa.nis ASC, nama_siswa ASC;

-- Lihat hasil: SELECT * FROM v_ratarata_siswa;

CREATE OR REPLACE VIEW v_pbo AS 
SELECT 
    siswa.nis, 
    nama_siswa, 
    kelas, 
    nilai AS nilai_pbo 
FROM siswa, nilai, mata_pelajaran 
WHERE siswa.nis = nilai.nis 
AND nilai.kode_mapel = mata_pelajaran.kode_mapel 
AND nama_mapel = 'Pemrograman Berorientasi Objek' 
ORDER BY nilai DESC;

SELECT * FROM v_pbo;

CREATE OR REPLACE VIEW v_web_xi_rpla AS 
SELECT 
    siswa.nis, 
    nama_siswa, 
    kelas, 
    nilai AS nilai_web, 
    CASE 
        WHEN nilai > 85 THEN 'Istimewa' 
        WHEN nilai >= 75 THEN 'Cukup' 
        ELSE 'Kurang' 
    END AS Predikat 
FROM siswa, nilai, mata_pelajaran 
WHERE siswa.nis = nilai.nis 
AND nilai.kode_mapel = mata_pelajaran.kode_mapel 
AND nama_mapel = 'Pemrograman Web' 
AND kelas = 'XI RPL A' 
ORDER BY siswa.nis ASC, nama_siswa ASC;

SELECT * FROM v_web_xi_rpla;
