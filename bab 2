SELECT 
    m.nama_mapel, 
    g.nama_guru, 
    ROUND(AVG(n.nilai), 2) AS rata_rata
FROM mata_pelajaran m
JOIN guru g ON m.nitp = g.nitp
JOIN nilai n ON m.kode_mapel = n.kode_mapel
GROUP BY m.kode_mapel, m.nama_mapel, g.nama_guru
ORDER BY m.kode_mapel ASC;

SELECT 
    s.nis, 
    s.nama_siswa, 
    m.nama_mapel, 
    n.nilai
FROM siswa s
JOIN nilai n ON s.nis = n.nis
JOIN mata_pelajaran m ON n.kode_mapel = m.kode_mapel
WHERE n.nilai < 80;

SELECT 
    s.nama_siswa, 
    s.kelas, 
    n.nilai,
    CASE 
        WHEN n.nilai > 80 THEN 'Baik'
        WHEN n.nilai >= 75 THEN 'Cukup'
        ELSE 'Kurang'
    END AS Predikat
FROM siswa s
JOIN nilai n ON s.nis = n.nis
JOIN mata_pelajaran m ON n.kode_mapel = m.kode_mapel
WHERE m.nama_mapel = 'Basis Data';

SELECT 
    s.nama_siswa, 
    s.kelas, 
    n.nilai,
    CASE 
        WHEN n.nilai > 85 THEN 'Istimewa'
        WHEN n.nilai > 80 THEN 'Baik'
        WHEN n.nilai >= 75 THEN 'Cukup'
        ELSE 'Kurang'
    END AS Predikat
FROM siswa s
JOIN nilai n ON s.nis = n.nis
JOIN mata_pelajaran m ON n.kode_mapel = m.kode_mapel
WHERE m.nama_mapel = 'Pemodelan Perangkat Lunak' 
AND s.kelas = 'XI RPL B';

CREATE OR REPLACE VIEW v_ratarata_siswa AS
SELECT 
    s.nis, 
    s.nama_siswa, 
    s.kelas, 
    ROUND(AVG(n.nilai), 1) AS rata_rata
FROM siswa s
JOIN nilai n ON s.nis = n.nis
GROUP BY s.nis, s.nama_siswa, s.kelas
ORDER BY s.nis ASC;

SELECT * FROM v_ratarata_siswa;

CREATE VIEW v_pbo AS
SELECT 
    s.nis, 
    s.nama_siswa, 
    s.kelas, 
    n.nilai AS nilai_pbo
FROM siswa s
JOIN nilai n ON s.nis = n.nis
JOIN mata_pelajaran m ON n.kode_mapel = m.kode_mapel
WHERE m.nama_mapel = 'Pemrograman Berorientasi Objek'
ORDER BY n.nilai DESC;

SELECT * FROM v_pbo;

CREATE VIEW v_web_xi_rpla AS
SELECT 
    s.nis, 
    s.nama_siswa, 
    s.kelas, 
    n.nilai AS nilai_web,
    CASE 
        WHEN n.nilai > 85 THEN 'Istimewa'
        WHEN n.nilai >= 75 THEN 'Cukup'
        ELSE 'Kurang'
    END AS Predikat
FROM siswa s
JOIN nilai n ON s.nis = n.nis
JOIN mata_pelajaran m ON n.kode_mapel = m.kode_mapel
WHERE m.nama_mapel = 'Pemrograman Web' 
AND s.kelas = 'XI RPL A';

SELECT * FROM v_web_xi_rpla;
