-- ============================================
-- DATABASE PENERBANGAN - Becky
-- ============================================

-- Membuat database
CREATE DATABASE IF NOT EXISTS db_penerbangan_becky;
USE db_penerbangan_becky;

-- ============================================
-- 1. MEMBUAT TABEL
-- ============================================

-- a. Akun
CREATE TABLE Akun (
    id_akun INT PRIMARY KEY AUTO_INCREMENT,
    username VARCHAR(50) NOT NULL UNIQUE,
    nama VARCHAR(100) NOT NULL,
    email VARCHAR(100),
    no_telepon VARCHAR(20)
);

-- b. Maskapai
CREATE TABLE Maskapai (
    id_maskapai INT PRIMARY KEY AUTO_INCREMENT,
    kode_maskapai VARCHAR(10) NOT NULL UNIQUE,
    nama_maskapai VARCHAR(100) NOT NULL,
    negara_asal VARCHAR(50)
);

-- c. Negara
CREATE TABLE Negara (
    id_negara INT PRIMARY KEY AUTO_INCREMENT,
    kode_negara VARCHAR(5) NOT NULL UNIQUE,
    nama_negara VARCHAR(100) NOT NULL
);

-- d. Bandara
CREATE TABLE Bandara (
    id_bandara INT PRIMARY KEY AUTO_INCREMENT,
    kode_bandara VARCHAR(10) NOT NULL UNIQUE,
    nama_bandara VARCHAR(100) NOT NULL,
    kota VARCHAR(50),
    id_negara INT,
    FOREIGN KEY (id_negara) REFERENCES Negara(id_negara)
);

-- e. Jadwal Penerbangan
CREATE TABLE Jadwal_Penerbangan (
    id_jadwal INT PRIMARY KEY AUTO_INCREMENT,
    kode_penerbangan VARCHAR(20) NOT NULL UNIQUE,
    id_maskapai INT,
    id_bandara_keberangkatan INT,
    id_bandara_tujuan INT,
    waktu_keberangkatan DATETIME,
    waktu_kedatangan DATETIME,
    harga DECIMAL(12,2),
    FOREIGN KEY (id_maskapai) REFERENCES Maskapai(id_maskapai),
    FOREIGN KEY (id_bandara_keberangkatan) REFERENCES Bandara(id_bandara),
    FOREIGN KEY (id_bandara_tujuan) REFERENCES Bandara(id_bandara)
);

-- f. Transaksi
CREATE TABLE Transaksi (
    id_transaksi INT PRIMARY KEY AUTO_INCREMENT,
    id_akun INT,
    id_jadwal INT,
    tanggal_transaksi DATETIME DEFAULT CURRENT_TIMESTAMP,
    kode_promo VARCHAR(20),
    total_harga DECIMAL(12,2),
    FOREIGN KEY (id_akun) REFERENCES Akun(id_akun),
    FOREIGN KEY (id_jadwal) REFERENCES Jadwal_Penerbangan(id_jadwal)
);

-- g. Detail Transaksi
CREATE TABLE Detail_Transaksi (
    id_detail INT PRIMARY KEY AUTO_INCREMENT,
    id_transaksi INT,
    nomor_kursi VARCHAR(10),
    status_pembayaran ENUM('Pending', 'Sukses', 'Gagal') DEFAULT 'Pending',
    FOREIGN KEY (id_transaksi) REFERENCES Transaksi(id_transaksi)
);

-- h. Kode Promo
CREATE TABLE Kode_Promo (
    id_promo INT PRIMARY KEY AUTO_INCREMENT,
    kode_promo VARCHAR(20) NOT NULL UNIQUE,
    persen_diskon DECIMAL(5,2),
    berlaku_hingga DATE
);

-- i. Status Penerbangan
CREATE TABLE Status_Penerbangan (
    id_status INT PRIMARY KEY AUTO_INCREMENT,
    nama_status VARCHAR(50) NOT NULL UNIQUE  -- contoh: On Time, Delayed, Cancelled, Boarding, Take Off, Landing
);

-- j. Perubahan Status Jadwal Penerbangan
CREATE TABLE Perubahan_Status_Jadwal (
    id_perubahan INT PRIMARY KEY AUTO_INCREMENT,
    id_jadwal INT,
    id_status INT,
    waktu_perubahan DATETIME DEFAULT CURRENT_TIMESTAMP,
    keterangan TEXT,
    FOREIGN KEY (id_jadwal) REFERENCES Jadwal_Penerbangan(id_jadwal),
    FOREIGN KEY (id_status) REFERENCES Status_Penerbangan(id_status)
);

