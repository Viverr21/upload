    kode_mapel VARCHAR(10) PRIMARY KEY NOT NULL,
    nitp VARCHAR(10) NOT NULL,
    nama_mapel VARCHAR(50) NOT NULL,
    FOREIGN KEY (nitp) REFERENCES guru(nitp)
